# ==============================================================================
# DocArch AI - Environment Variables Reference Guide
# Configure these in your GitHub Repository (Settings > Secrets and variables > Actions)
# or in Cloudflare Pages (Settings > Environment variables) or local .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RDBMS Database Connectivity (Supabase PostgreSQL / Liquibase)
# ------------------------------------------------------------------------------
# Supabase Project HTTPS API URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (recommended for server-side RLS bypass and secure API calls)
# GitHub Secret: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Anon Public Key (optional fallback)
# GitHub Variable/Secret: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL Connection URL (Alternative to direct Supabase URL, also used by Liquibase)
# GitHub Secret: DATABASE_URL
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Liquibase Granular Credentials (optional if DATABASE_URL is set)
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & At-Rest Encryption
# ------------------------------------------------------------------------------
# 32+ character high-entropy key used for AES-256-GCM encryption of user API keys
# GitHub Secret: ENCRYPTION_SECRET
ENCRYPTION_SECRET=your-custom-production-super-secret-key-32-chars-min!!

# ------------------------------------------------------------------------------
# 3. AI Provider Configuration (OpenAI Primary)
# ------------------------------------------------------------------------------
# Official OpenAI API Key (Server-side only, never exposed to client)
# Generate from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional: Default OpenAI Model (defaults to gpt-4o, also supports gpt-4o-mini)
OPENAI_MODEL=gpt-4o

# Optional: Custom OpenAI Base URL (for Azure OpenAI, Ollama, or corporate API gateways)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Secondary Fallbacks
# GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# 4. Cloudflare Pages Deployment (GitHub Secrets)
# ------------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...

# ------------------------------------------------------------------------------
# 5. Application Host & Links
# ------------------------------------------------------------------------------
# Base URL used to construct verification and password-reset links in emails
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Email Infrastructure (SMTP2GO REST API over fetch)
# ------------------------------------------------------------------------------
# Mode: "smtp2go" (real) or "console" (logs email content and link to terminal)
# If SMTP2GO_API_KEY is omitted, defaults automatically to zero-config ConsoleMailer.
EMAIL_PROVIDER=console
SMTP2GO_API_KEY=api-YOUR-SMTP2GO-KEY-HERE
MAIL_FROM=no-reply@yourverifieddomain.com

# Cost Guards & Rate Limits (Below SMTP2GO free tier: 1000/mo, 200/day)
EMAIL_DAILY_CAP=180
EMAIL_MONTHLY_CAP=900

# ------------------------------------------------------------------------------
# 7. SMS Infrastructure (Message Central VerifyNow for OTP)
# ------------------------------------------------------------------------------
# Mode: "messagecentral" (real) or "console" (logs OTP to terminal)
# Phone verification is OPTIONAL (only required for SMS notifications).
SMS_PROVIDER=console
MESSAGECENTRAL_CUSTOMER_ID=C-YOUR-CUSTOMER-ID
MESSAGECENTRAL_KEY=YOUR-MESSAGECENTRAL-KEY
MESSAGECENTRAL_EMAIL=your-account@domain.com
MESSAGECENTRAL_SENDER_ID=UTILITY

# SMS Hard Caps (Prevents runaway spend on prepaid credit)
SMS_DAILY_CAP=50
SMS_PER_USER_DAILY_CAP=5
SMS_PER_IP_DAILY_CAP=10

# ------------------------------------------------------------------------------
# 8. Anti-Abuse Protection (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Optional: Enforce Turnstile CAPTCHA on phone verification sends
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
